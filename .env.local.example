# ============================================================
# SOCIAL LISTENER - Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ============================================================

# --- APIs existantes ---
# Anthropic Claude API Key (analyse de sentiment)
ANTHROPIC_API_KEY=sk-ant-...

# Tavily Search API (fallback si pas d'APIs sociales)
TAVILY_API_KEY=tvly-...

# --- Sujet surveillé ---
NEXT_PUBLIC_SUBJECT_NAME="Olushegun ADJADI BAKARI"
NEXT_PUBLIC_PLATFORMS="twitter,instagram,facebook,linkedin,tiktok"

# ============================================================
# TWITTER / X - API v2
# https://developer.twitter.com/en/portal/dashboard
# Créer une App > onglet Keys and Tokens > Bearer Token
# ============================================================
TWITTER_BEARER_TOKEN=AAAAAAAAAA...

# ============================================================
# FACEBOOK - Graph API v19
# https://developers.facebook.com/apps/
# Créer une App Business > Permissions : pages_read_engagement
# ============================================================
FACEBOOK_ACCESS_TOKEN=EAA...
FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret
FACEBOOK_PAGE_ID=your_page_id  # ID de ta page Facebook (optionnel)

# ============================================================
# INSTAGRAM - Graph API (via Meta)
# Compte Instagram doit être en mode Business ou Creator
# https://developers.facebook.com/apps/ > Instagram Basic Display
# ============================================================
INSTAGRAM_ACCESS_TOKEN=IGQ...  # Long-lived token (60 jours)
INSTAGRAM_USER_ID=your_instagram_user_id  # ID numérique du compte IG

# ============================================================
# LINKEDIN - API v2
# https://www.linkedin.com/developers/apps
# Créer une App > Permissions : r_organization_social
# ============================================================
LINKEDIN_ACCESS_TOKEN=AQV...
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_ORGANIZATION_ID=your_org_id  # ID numérique de ta Company Page

# ============================================================
# TIKTOK - Research API ou Display API
# https://developers.tiktok.com/
# Research API : demande d'accès requise (1-4 semaines)
# Display API : accès immédiat mais données limitées
# ============================================================
TIKTOK_CLIENT_KEY=aw...
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_ACCESS_TOKEN=act...  # Display API token
TIKTOK_RESEARCH_TOKEN=rta...  # Research API token (si approuvé)

# ============================================================
# CRON - Sécurité endpoint /api/collect
# Générer une clé aléatoire forte
# ============================================================
CRON_SECRET=your_random_secret_key_here
